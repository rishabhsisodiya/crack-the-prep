---
import BaseLayout from '../../layouts/BaseLayout.astro';

const SECTIONS = [
  { slug: 'javascript', label: 'JavaScript', badge: 'JS' },
  { slug: 'react', label: 'React', badge: '⚛' },
  { slug: 'nodejs', label: 'Node.js', badge: '⬢' },
];
const COUNTS = [10, 20, 30];
const LETTERS = ['A', 'B', 'C', 'D'];
---

<BaseLayout
  title="Quiz"
  description="A self-test quiz drawn from the JavaScript, React and Node.js question banks — pick your sections, answer multiple-choice, see your score."
>
  <section class="wrap sp">
    <p class="eyebrow">Quiz</p>
    <h1>Test yourself</h1>
    <p class="sub">Questions are pulled straight from the question banks — no two runs are the same.</p>

    <div id="quiz-root" data-base={import.meta.env.BASE_URL}>
      <form id="setup" class="setup card">
        <div class="field">
          <p class="field-label">Sections</p>
          <div class="sections">
            {SECTIONS.map((s) => (
              <label class="sect">
                <input type="checkbox" name="section" value={s.slug} checked />
                <span class="sect-card">
                  <span class="sect-badge">{s.badge}</span>
                  <span class="sect-name">{s.label}</span>
                  <span class="sect-count" data-count={s.slug}>…</span>
                </span>
              </label>
            ))}
          </div>
        </div>

        <div class="field">
          <p class="field-label">How many questions</p>
          <div class="counts">
            {COUNTS.map((n, i) => (
              <label class="cnt">
                <input type="radio" name="count" value={n} checked={i === 0} />
                <span class="cnt-pill">{n}</span>
              </label>
            ))}
          </div>
        </div>

        <p class="err" id="setup-err" hidden></p>
        <button type="submit" class="btn-primary btn-full">Start quiz →</button>
      </form>

      <div id="run" class="run card" hidden>
        <div class="run-head">
          <div class="run-head-top">
            <span class="progress" id="progress"></span>
            <span class="score" id="live-score"></span>
          </div>
          <div class="bar"><div class="bar-fill" id="bar-fill"></div></div>
        </div>

        <p class="section-tag" id="section-tag"></p>
        <p class="qtext" id="qtext"></p>
        <div class="prompt answer" id="qprompt" hidden></div>

        <button type="button" class="btn-primary btn-full" id="show-options">Think first — show options</button>
        <div class="options" id="options" hidden></div>

        <div class="reveal-only" id="reveal-only" hidden>
          <button type="button" class="btn-primary btn-full" id="show-answer">Think first — show answer</button>
          <div class="answer-wrap" id="answer-wrap" hidden>
            <p class="reveal-tag">Answer</p>
            <div class="answer" id="reveal-answer"></div>
            <button type="button" class="btn-primary btn-full" id="reveal-next">Next →</button>
          </div>
        </div>
      </div>

      <div id="result" class="result card" hidden>
        <p class="result-tag">Quiz complete</p>
        <p class="score-big" id="final-score"></p>
        <p class="score-pct" id="final-pct"></p>
        <button type="button" class="btn-primary" id="restart">Try again</button>
      </div>

      <p class="loaderr" id="load-err" hidden>Couldn't load the question bank — try refreshing.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .sp { padding: 3rem 0 5rem; max-width: 720px; }
  h1 { font-family: var(--font-display); font-size: clamp(2.2rem, 6vw, 3.2rem); letter-spacing: 0.03em; margin: 0.6rem 0; }
  .sub { color: var(--muted); margin-bottom: 2rem; }

  .card {
    border: 1px solid var(--navy-line);
    border-radius: 12px;
    background: var(--navy-card);
    padding: 1.6rem;
  }

  /* ---- setup ---- */
  .field { margin-bottom: 1.6rem; }
  .field-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 0.7rem;
  }

  .sections { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.7rem; }
  .sect { cursor: pointer; }
  .sect input { position: absolute; opacity: 0; width: 0; height: 0; }
  .sect-card {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--navy-line-2);
    border-radius: 8px;
    background: var(--navy-mid);
    transition: border-color 0.15s, background 0.15s;
  }
  .sect input:checked + .sect-card {
    border-color: var(--cyan);
    background: rgba(0, 180, 216, 0.1);
  }
  .sect input:focus-visible + .sect-card { outline: 2px solid var(--accent); outline-offset: 2px; }
  .sect-badge {
    flex-shrink: 0;
    width: 26px; height: 26px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--cyan);
    background: rgba(0, 180, 216, 0.12);
    border-radius: 6px;
  }
  .sect-name { font-size: 0.9rem; color: var(--text); font-weight: 600; }
  .sect-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
  }

  .counts { display: flex; gap: 0.6rem; }
  .cnt input { position: absolute; opacity: 0; width: 0; height: 0; }
  .cnt-pill {
    display: block;
    min-width: 54px;
    text-align: center;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--navy-line-2);
    border-radius: 7px;
    background: var(--navy-mid);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .cnt input:checked + .cnt-pill { border-color: var(--cyan); background: rgba(0, 180, 216, 0.12); color: var(--cyan); }
  .cnt input:focus-visible + .cnt-pill { outline: 2px solid var(--accent); outline-offset: 2px; }

  .err { color: var(--danger); font-size: 0.85rem; margin: 0 0 1rem; }
  .err:not([hidden]) { display: block; }

  .btn-primary {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.8rem 1.6rem;
    background: var(--cyan);
    color: var(--navy);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 700;
    transition: filter 0.15s, transform 0.1s;
  }
  .btn-primary:hover { filter: brightness(1.1); }
  .btn-primary:active { transform: scale(0.98); }
  .btn-full { width: 100%; }

  /* ---- run ---- */
  .run-head { margin-bottom: 1.2rem; }
  .run-head-top {
    display: flex; justify-content: space-between; align-items: baseline;
    font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .score { color: var(--cyan); font-weight: 700; }
  .bar { height: 4px; background: var(--navy-line); border-radius: 4px; overflow: hidden; }
  .bar-fill { height: 100%; background: var(--cyan); border-radius: 4px; transition: width 0.25s ease; }

  .section-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cyan);
    background: rgba(0, 180, 216, 0.1);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    margin-bottom: 0.8rem;
  }
  .qtext { font-size: 1.2rem; font-weight: 600; color: var(--white); line-height: 1.4; margin: 0 0 1.4rem; }
  .prompt:not([hidden]) { display: block; }
  .prompt { margin-top: -0.6rem; }

  .options { display: flex; flex-direction: column; gap: 0.6rem; }
  /* options are appended by client JS, so these rules must be :global —
     Astro's scoped-style attribute is only added to elements in this
     file's own template, never to elements created via createElement. */
  .options :global(.opt) {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    text-align: left;
    width: 100%;
    padding: 0.85rem 1rem;
    background: var(--navy-mid);
    border: 1px solid var(--navy-line-2);
    border-radius: 8px;
    color: var(--text);
    cursor: pointer;
    font-size: 0.92rem;
    line-height: 1.55;
    transition: border-color 0.15s, background 0.15s;
  }
  .options :global(.opt-letter) {
    flex-shrink: 0;
    width: 22px; height: 22px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--muted);
    border: 1px solid var(--navy-line-2);
    border-radius: 5px;
    margin-top: 0.05rem;
  }
  .options :global(.opt:hover:not([disabled])) { border-color: var(--cyan); background: rgba(0, 180, 216, 0.06); }
  .options :global(.opt:hover:not([disabled]) .opt-letter) { border-color: var(--cyan); color: var(--cyan); }
  .options :global(.opt.correct) { border-color: var(--green); background: rgba(6, 214, 160, 0.1); }
  .options :global(.opt.correct .opt-letter) { border-color: var(--green); color: var(--green); }
  .options :global(.opt.wrong) { border-color: var(--danger); background: rgba(255, 107, 107, 0.1); }
  .options :global(.opt.wrong .opt-letter) { border-color: var(--danger); color: var(--danger); }
  .options :global(.opt-mono) {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .options :global(.opt[disabled]) { cursor: default; }
  .options :global(.opt[disabled]:not(.correct):not(.wrong)) { opacity: 0.45; }

  .reveal-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 0.6rem;
  }
  .answer {
    background: var(--navy-mid);
    border: 1px solid var(--navy-line-2);
    border-radius: 8px;
    padding: 1rem 1.1rem;
    margin-bottom: 1.2rem;
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.65;
  }
  .answer :global(p) { margin: 0 0 0.7rem; }
  .answer :global(p:last-child) { margin-bottom: 0; }
  .answer :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: rgba(0, 180, 216, 0.12);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    color: var(--blue-light);
  }
  .answer :global(pre) {
    background: var(--navy);
    border: 1px solid var(--navy-line);
    border-radius: 6px;
    padding: 0.9rem 1rem;
    overflow-x: auto;
    margin: 0.7rem 0;
  }
  .answer :global(pre code) { background: none; padding: 0; color: var(--text); font-size: 0.82rem; }
  .answer :global(strong) { color: var(--white); }

  /* ---- result ---- */
  .result { text-align: center; padding: 2.4rem 1.6rem; }
  .result-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .score-big { font-family: var(--font-display); font-size: 3rem; color: var(--cyan); letter-spacing: 0.02em; }
  .score-pct { color: var(--muted); margin: 0.3rem 0 1.6rem; }
  .loaderr { color: var(--danger); margin-top: 1rem; }
</style>

<script>
  type Q = {
    id: string;
    section: string;
    question: string;
    promptMd: string;
    answerMd: string;
    answerPlain: string;
    kind: 'output' | 'concept';
    mcq: boolean;
  };
  type Data = { sections: Record<string, { label: string; count: number }>; questions: Q[] };

  const LETTERS = ['A', 'B', 'C', 'D'];
  const SECTION_LABELS: Record<string, string> = { javascript: 'JavaScript', react: 'React', nodejs: 'Node.js' };

  const root = document.getElementById('quiz-root') as HTMLElement;
  const base = root.dataset.base ?? '/';
  const setupForm = document.getElementById('setup') as HTMLFormElement;
  const setupErr = document.getElementById('setup-err') as HTMLElement;
  const runEl = document.getElementById('run') as HTMLElement;
  const resultEl = document.getElementById('result') as HTMLElement;
  const loadErr = document.getElementById('load-err') as HTMLElement;

  let data: Data | null = null;
  let pool: Q[] = [];
  let idx = 0;
  let score = 0;

  // very small markdown → HTML: fenced code, inline code, bold, paragraphs
  function mdToHtml(md: string): string {
    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    let html = esc(md);
    html = html.replace(/```[a-z]*\n([\s\S]*?)```/g, (_m, code) => `<pre><code>${code}</code></pre>`);
    const parts = html.split(/(<pre>[\s\S]*?<\/pre>)/g);
    for (let i = 0; i < parts.length; i++) {
      if (parts[i].startsWith('<pre>')) continue;
      parts[i] = parts[i]
        .replace(/`([^`]+)`/g, '<code>$1</code>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/\n{2,}/g, '</p><p>')
        .replace(/\n/g, '<br>');
      parts[i] = `<p>${parts[i]}</p>`;
    }
    return parts.join('');
  }

  function shuffle<T>(arr: T[]): T[] {
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  async function loadData(): Promise<Data> {
    const res = await fetch(`${base.replace(/\/$/, '')}/quiz-data.json`);
    if (!res.ok) throw new Error('fetch failed');
    return res.json();
  }

  function buildDistractors(q: Q, sectionPool: Q[]): string[] {
    // decoys must be the same kind — an output like "2 1" next to a prose definition gives the answer away
    const candidates = sectionPool.filter((c) => c.id !== q.id && c.mcq && c.kind === q.kind);
    const shuffled = shuffle(candidates);
    const picked: string[] = [];
    const seen = new Set([q.answerPlain]);
    for (const c of shuffled) {
      if (picked.length >= 3) break;
      if (seen.has(c.answerPlain)) continue;
      seen.add(c.answerPlain);
      picked.push(c.answerPlain);
    }
    return picked;
  }

  function updateHead(q: Q) {
    (document.getElementById('progress') as HTMLElement).textContent = `Question ${idx + 1} of ${pool.length}`;
    (document.getElementById('live-score') as HTMLElement).textContent = `Score ${score}`;
    (document.getElementById('bar-fill') as HTMLElement).style.width = `${(idx / pool.length) * 100}%`;
    (document.getElementById('section-tag') as HTMLElement).textContent = SECTION_LABELS[q.section] ?? q.section;
    (document.getElementById('qtext') as HTMLElement).textContent = q.question;
    const promptEl = document.getElementById('qprompt') as HTMLElement;
    promptEl.innerHTML = q.promptMd ? mdToHtml(q.promptMd) : '';
    promptEl.hidden = !q.promptMd;
  }

  function renderQuestion() {
    const q = pool[idx];
    updateHead(q);

    const optionsEl = document.getElementById('options') as HTMLElement;
    const revealBox = document.getElementById('reveal-only') as HTMLElement;
    const showOptionsBtn = document.getElementById('show-options') as HTMLElement;
    const showAnswerBtn = document.getElementById('show-answer') as HTMLElement;
    const answerWrap = document.getElementById('answer-wrap') as HTMLElement;

    optionsEl.innerHTML = '';
    optionsEl.hidden = true;
    revealBox.hidden = true;
    showOptionsBtn.hidden = true;
    answerWrap.hidden = true;

    const sectionPool = data!.questions.filter((c) => c.section === q.section);
    const distractors = q.mcq ? buildDistractors(q, sectionPool) : [];

    if (!q.mcq || distractors.length < 3) {
      // fall back to reveal-style for questions without enough short decoys
      revealBox.hidden = false;
      showAnswerBtn.hidden = false;
      (document.getElementById('reveal-answer') as HTMLElement).innerHTML = mdToHtml(q.answerMd);
      (document.getElementById('reveal-next') as HTMLButtonElement).onclick = () => next();
      showAnswerBtn.onclick = () => {
        showAnswerBtn.hidden = true;
        answerWrap.hidden = false;
      };
      return;
    }

    const options = shuffle([q.answerPlain, ...distractors]);
    showOptionsBtn.hidden = false;
    showOptionsBtn.onclick = () => {
      showOptionsBtn.hidden = true;
      optionsEl.hidden = false;
    };
    options.forEach((opt, i) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'opt';
      btn.dataset.correct = String(opt === q.answerPlain);
      btn.innerHTML = `<span class="opt-letter">${LETTERS[i]}</span><span${q.kind === 'output' ? ' class="opt-mono"' : ''}>${opt.replace(/&/g, '&amp;').replace(/</g, '&lt;')}</span>`;
      btn.addEventListener('click', () => {
        const correct = btn.dataset.correct === 'true';
        [...optionsEl.querySelectorAll<HTMLButtonElement>('button')].forEach((b) => {
          b.setAttribute('disabled', 'true');
          if (b.dataset.correct === 'true') b.classList.add('correct');
          else if (b === btn) b.classList.add('wrong');
        });
        if (correct) score++;
        (document.getElementById('live-score') as HTMLElement).textContent = `Score ${score}`;
        setTimeout(next, 900);
      });
      optionsEl.appendChild(btn);
    });
  }

  function next() {
    idx++;
    if (idx >= pool.length) return finish();
    renderQuestion();
  }

  function finish() {
    (document.getElementById('bar-fill') as HTMLElement).style.width = '100%';
    runEl.hidden = true;
    resultEl.hidden = false;
    (document.getElementById('final-score') as HTMLElement).textContent = `${score} / ${pool.length}`;
    const pct = Math.round((score / pool.length) * 100);
    (document.getElementById('final-pct') as HTMLElement).textContent = `${pct}% correct`;
  }

  setupForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    setupErr.hidden = true;
    const sections = [...setupForm.querySelectorAll<HTMLInputElement>('input[name="section"]:checked')].map((i) => i.value);
    const count = Number((setupForm.querySelector('input[name="count"]:checked') as HTMLInputElement)?.value ?? 10);

    if (!sections.length) {
      setupErr.textContent = 'Pick at least one section.';
      setupErr.hidden = false;
      return;
    }

    try {
      if (!data) data = await loadData();
    } catch {
      loadErr.hidden = false;
      return;
    }

    const available = data.questions.filter((q) => sections.includes(q.section));
    if (!available.length) {
      setupErr.textContent = 'No questions available for the chosen sections yet.';
      setupErr.hidden = false;
      return;
    }

    pool = shuffle(available).slice(0, Math.min(count, available.length));
    idx = 0;
    score = 0;

    setupForm.hidden = true;
    resultEl.hidden = true;
    runEl.hidden = false;
    renderQuestion();
  });

  document.getElementById('restart')?.addEventListener('click', () => {
    resultEl.hidden = true;
    setupForm.hidden = false;
  });

  loadData()
    .then((d) => {
      data = d;
      for (const [slug, info] of Object.entries(d.sections)) {
        const el = document.querySelector(`[data-count="${slug}"]`);
        if (el) el.textContent = `${info.count} questions`;
      }
    })
    .catch(() => {
      loadErr.hidden = false;
    });
</script>
