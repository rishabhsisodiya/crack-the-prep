---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrackCard from '../components/TrackCard.astro';
import { SITE, TRACKS, u } from '../consts';
---

<BaseLayout>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">CrackThePrep</p>
      <h1>Interview preparation for full-stack engineers.</h1>
      <p class="hero-sub">
        Working notes, questions with hidden answers, and worked examples across the
        stack — JavaScript, React, Node.js, system design, DSA and behavioral.
        Free, no sign-up, built from years of real interview and delivery notes.
      </p>
      <div class="hero-cta">
        <a class="btn" href={u('/plan')}>Start with the prep plan</a>
        <a class="btn btn--ghost" href={u('/javascript')}>Jump into JavaScript</a>
      </div>
    </div>
  </section>

  <section class="tracks wrap">
    <h2 class="tracks-h">Tracks</h2>
    <div class="tracks-grid">
      {TRACKS.map((track) => <TrackCard track={track} />)}
    </div>
  </section>

  <section class="note wrap">
    <p>
      Spot something wrong? Open an issue on the
      <a href="https://github.com/rishabhsisodiya/crack-the-prep">CrackThePrep repo</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: clamp(3rem, 8vw, 6rem) 0 clamp(2.5rem, 6vw, 4rem);
    background:
      radial-gradient(ellipse 60% 60% at 75% 30%, rgba(0, 119, 182, 0.18), transparent 70%),
      radial-gradient(ellipse 40% 40% at 10% 90%, rgba(0, 180, 216, 0.08), transparent 60%);
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 7vw, 5rem);
    letter-spacing: 0.02em;
    margin: 1rem 0;
    max-width: 16ch;
  }
  .hero-sub { max-width: 60ch; font-size: 1.05rem; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2rem; }

  .btn {
    display: inline-block;
    padding: 0.7rem 1.4rem;
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    background: linear-gradient(135deg, var(--electric), var(--cyan));
    color: var(--navy);
  }
  .btn:hover { color: var(--navy); filter: brightness(1.08); }
  .btn--ghost {
    background: none;
    border: 1px solid var(--navy-line-2);
    color: var(--cyan);
  }

  .tracks { padding-top: 3.5rem; }
  .tracks-h {
    font-family: var(--font-display);
    font-size: 1.8rem;
    letter-spacing: 0.06em;
    margin-bottom: 1.6rem;
  }
  .tracks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.1rem;
  }

  .note {
    margin-top: 3rem;
    font-size: 0.88rem;
    color: var(--muted);
  }
</style>
