---
import { getCollection, render } from 'astro:content';
import PrepLayout from '../../layouts/PrepLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { TRACKS, trackBySlug, u, noteSlug } from '../../consts';

export function getStaticPaths() {
  return TRACKS.filter((t) => t.slug !== 'dsa').map((t) => ({ params: { track: t.slug } }));
}

const { track } = Astro.params;
const meta = trackBySlug(track!)!;

const all = await getCollection('notes', (e) => e.data.track === track && e.data.kind === 'notes' && !e.data.draft);
all.sort((a, b) => a.data.order - b.data.order);

const pageSlug = (e: (typeof all)[number]) => noteSlug(e.data);

// 1 doc  -> render inline.  2 docs -> render primary + link secondary.  3+ -> a contents list.
const contentsMode = all.length >= 3;
const primary = contentsMode ? undefined : all[0];
const secondary = contentsMode ? all : all.slice(1);

let Content, headings, updated;
if (primary) {
  ({ Content, headings } = await render(primary));
  updated = primary.data.updated;
}
---

<PrepLayout track={track!} title={meta.title} description={primary?.data.description ?? meta.blurb}>
  {primary && headings && (
    <Fragment slot="toc"><TableOfContents headings={headings} /></Fragment>
  )}

  <article class="prose">
    <h1>{meta.title}</h1>
    <p class="lede">{meta.blurb}</p>

    {(meta.hasQuestions || secondary.length > 0) && (
      <ul class="track-links">
        {meta.hasQuestions && (
          <li><a href={u(`/${track}/questions`)}>→ {meta.title} interview questions</a></li>
        )}
        {!contentsMode && secondary.map((e) => (
          <li><a href={u(`/${track}/${pageSlug(e)}`)}>→ {e.data.title}</a></li>
        ))}
      </ul>
    )}

    {contentsMode ? (
      <>
        <p class="count">{secondary.length} chapters</p>
        <ol class="chapters">
          {secondary.map((e, i) => (
            <li>
              <a href={u(`/${track}/${pageSlug(e)}`)}>
                <span class="chapters-n">{String(i + 1).padStart(2, '0')}</span>
                <span class="chapters-t">
                  {e.data.title}
                  {e.data.imp && <span class="imp-badge">high-yield</span>}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </>
    ) : primary ? (
      <>
        {updated && (
          <p class="reviewed">Last reviewed {updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</p>
        )}
        <Content />
      </>
    ) : (
      <div class="soon">
        <p class="soon-tag">Coming next</p>
        <p>This track is written up in a later build step.</p>
        <p><a href={u('/')}>← All tracks</a></p>
      </div>
    )}
  </article>
</PrepLayout>

<style>
  .lede { font-size: 1.05rem; color: var(--text); margin: 0.4rem 0 1rem; }
  .reviewed { font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); margin: 0 0 1.4rem; }
  .count { font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); margin: 0.4rem 0 1rem; }
  .track-links { list-style: none; margin: 0 0 1.8rem; padding: 0; display: flex; flex-direction: column; gap: 0.3rem; }
  .track-links a { font-family: var(--font-mono); font-size: 0.82rem; }

  .chapters { list-style: none; margin: 0; padding: 0; counter-reset: none; display: flex; flex-direction: column; gap: 0.15rem; }
  .chapters a {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 0.7rem 0.9rem;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--text);
  }
  .chapters a:hover { border-color: var(--navy-line); background: var(--navy-card); color: var(--white); }
  .chapters-n { font-family: var(--font-mono); font-size: 0.75rem; color: var(--cyan); }
  .chapters-t { font-weight: 500; }

  .soon { border: 1px solid var(--navy-line); border-left: 3px solid var(--cyan); border-radius: 0 6px 6px 0; padding: 1.2rem 1.4rem; background: var(--navy-card); }
  .soon-tag { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--cyan); margin-bottom: 0.4rem; }
  .soon p { margin: 0.4rem 0; }
</style>
