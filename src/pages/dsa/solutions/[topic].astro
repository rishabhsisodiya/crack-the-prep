---
import PrepLayout from '../../../layouts/PrepLayout.astro';
import { solutions } from '../../../data/dsa-solutions.mjs';
import '../../../styles/dsa.css';
import { u, kebab } from '../../../consts';

// distinct topics, first-seen order
const topics = [];
for (const s of solutions) if (!topics.includes(s.topic)) topics.push(s.topic);

export function getStaticPaths() {
  const seen = [];
  for (const s of solutions) if (!seen.includes(s.topic)) seen.push(s.topic);
  return seen.map((t, i) => ({
    params: { topic: t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') },
    props: { topic: t, prevTopic: seen[i - 1] ?? null, nextTopic: seen[i + 1] ?? null },
  }));
}

const { topic, prevTopic, nextTopic } = Astro.props;
const items = solutions.filter((s) => s.topic === topic);
const approaches = items.reduce((n, s) => n + s.approaches.length, 0);

const prev = prevTopic
  ? { href: u(`/dsa/solutions/${kebab(prevTopic)}`), label: prevTopic }
  : { href: u('/dsa/solutions'), label: 'All topics' };
const next = nextTopic ? { href: u(`/dsa/solutions/${kebab(nextTopic)}`), label: nextTopic } : undefined;
---

<PrepLayout
  track="dsa"
  title={`${topic} — DSA Solutions`}
  description={`${items.length} ${topic} problems to practise: write your own solution, run it against tests, then compare with the worked approaches.`}
  prev={prev}
  next={next}
>
  <div class="prose">
    <nav class="crumbs">
      <a href={u('/dsa/solutions')}>Solutions</a> <span aria-hidden="true">/</span> {topic}
    </nav>
    <h1>{topic}</h1>
    <p class="lede">{items.length} problems · {approaches} approaches</p>
    <p class="xlink">
      <a href={u('/dsa')}>← Checklist</a> · <a href={u('/dsa/solutions')}>All topics →</a>
    </p>
  </div>

  <ul class="sol-list">
    {items.map((s) => (
      <li>
        <a class="sol" href={u(`/dsa/solutions/${kebab(topic)}/${kebab(s.problem)}`)} data-slug={kebab(s.problem)}>
          <span class="q">{s.problem}</span>
          {s.difficulty && <span class={`diff diff--${s.difficulty.toLowerCase()}`}>{s.difficulty}</span>}
          <span class="n">{s.approaches.length} {s.approaches.length === 1 ? 'approach' : 'approaches'}</span>
        </a>
      </li>
    ))}
  </ul>
</PrepLayout>

<style>
  .crumbs { font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); display: flex; gap: 0.5rem; }
  .lede { font-family: var(--font-mono); font-size: 0.8rem; color: var(--muted); margin: 0.3rem 0 0.6rem; }
  .xlink { font-family: var(--font-mono); font-size: 0.8rem; }

  .sol-list { list-style: none; margin: 1.4rem 0 0; padding: 0; }
  .sol {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
    padding: 0.9rem 1.1rem;
    margin: 0.7rem 0;
    border: 1px solid var(--navy-line);
    border-radius: 8px;
    background: var(--navy-card);
    transition: border-color 0.2s;
  }
  .sol:hover { border-color: var(--navy-line-2); }
  .sol::before { content: '›'; color: var(--cyan); font-family: var(--font-mono); }
  .sol .q { font-weight: 600; color: var(--white); }
  .sol .n { margin-left: auto; font-family: var(--font-mono); font-size: 0.68rem; color: var(--muted); }
</style>

<script>
  // Problems used to be sections of this page: forward an old #problem link to its own page.
  const slug = decodeURIComponent(location.hash.slice(1));
  const link = slug && [...document.querySelectorAll<HTMLAnchorElement>('.sol[data-slug]')].find((a) => a.dataset.slug === slug);
  if (link) location.replace(link.href);
</script>
