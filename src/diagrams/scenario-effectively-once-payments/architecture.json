      "title": "Ordering"
    },
    {
      "dot": "rose",
      "items": [
        "Daily reconciliation against provider settlement files catches anything the stream missed",
        "Append-only ledger: corrections are new entries, never edits"
      ],
      "title": "Safety net"
    }
