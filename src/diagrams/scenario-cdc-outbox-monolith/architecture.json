  "cards": [
    {
      "dot": "cyan",
      "items": [
        "Business row + outbox row written in one Postgres transaction \u2014 no dual-write gap",
        "Debezium tails the WAL and publishes the outbox row, then it can be deleted"
      ],
      "title": "Outbox"
    },
    {
      "dot": "emerald",
      "items": [
        "Kafka partitioned by aggregate_id keeps per-order / per-payment ordering",
        "Consumers dedup on event_id for exactly-once effects, not delivery"
      ],
      "title": "Streaming"
    },
    {
      "dot": "rose",
      "items": [
        "Zero-downtime rollout: add table, deploy code, start CDC \u2014 no rewrite, no flag day",
        "New consumers backfill from a snapshot, then catch up on the stream"
      ],
      "title": "Migration"
    }
  ],
