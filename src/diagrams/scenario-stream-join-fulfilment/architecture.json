      "title": "Window & Grace"
    },
    {
      "dot": "rose",
      "items": [
        "State store backed by a changelog topic \u2014 replay rebuilds local state",
        "Idempotent fulfilment trigger on order_id gives exactly-once effects, not delivery"
      ],
      "title": "State Recovery"
    }
  ],
