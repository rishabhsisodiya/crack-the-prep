  "cards": [
    {
      "dot": "cyan",
      "title": "Idempotency",
      "items": [
        "The client's Idempotency-Key is stored before charging \u2014 a retry returns the original result, never a second charge"
      ]
    },
    {
      "dot": "emerald",
      "title": "Outbox",
      "items": [
        "Intent and ledger event commit in one transaction; the relay publishes only committed work",
        "Webhooks advance the state machine; the ledger is written from state, not from the request"
      ]
    },
    {
      "dot": "orange",
      "title": "Safety net",
      "items": [
        "Reconciliation compares the ledger against PSP records and catches anything the webhooks missed"
