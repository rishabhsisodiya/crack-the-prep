  "cards": [
    {
      "title": "Two separate systems",
      "dot": "cyan",
      "items": [
        "Upload / transcode path is write-heavy, async and latency-tolerant \u2014 never block the upload on encoding",
        "Playback path is read-heavy, synchronous and latency-critical, served almost entirely from the CDN edge"
      ]
    },
    {
      "title": "Cost driver",
      "dot": "emerald",
      "items": [
        "Storage and egress bandwidth, not compute, dominate cost at this scale",
        "Per-title encoding and tiering cold video to cheaper storage cut that cost directly"
      ]
    },
    {
      "title": "Failure distinction",
      "dot": "rose",
      "items": [
        "CDN failure degrades gracefully \u2014 fall back to origin or another edge region",
        "Origin failure is harder: cached content still plays, but every cache miss fails"
      ]
    }
  ],
