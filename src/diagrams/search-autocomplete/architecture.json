  "cards": [
    {
      "dot": "cyan",
      "title": "Precompute offline",
      "items": [
        "Ranking happens in the offline pipeline, never at request time",
        "A lookup walks the prefix and returns its precomputed top-K"
      ]
    },
    {
      "dot": "emerald",
      "title": "Memory-speed read path",
      "items": [
        "CDN and Redis cover hot prefixes; the sharded trie serves the rest",
        "p99 well under 100ms, set by typing cadence"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure mode",
      "items": [
        "The trie is a derived structure, rebuildable from query logs",
        "If it dies, suggestions disappear \u2014 search itself keeps working"
      ]
    }
  ]
