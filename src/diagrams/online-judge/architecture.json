  "cards": [
    {
      "dot": "rose",
      "title": "Isolation",
      "items": [
        "Untrusted code only ever runs inside a per-submission sandbox (container/microVM) with strict limits",
        "Submissions are persisted and queued by priority before any runner touches them"
      ]
    },
    {
      "dot": "cyan",
      "title": "Feedback loop",
      "items": [
        "Runners autoscale on queue depth, write the verdict back, and push it over pub/sub to the browser",
        "Contest results flow to the scoring service and the Redis leaderboard"
      ]
    }
