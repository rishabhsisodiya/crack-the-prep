  "cards": [
    {
      "dot": "cyan",
      "title": "The core property",
      "items": [
        "A key belongs to the first node clockwise from its hash",
        "Removing a node only remaps keys between it and its predecessor \u2014 about 1/N of keys"
      ]
    },
    {
      "dot": "rose",
      "title": "Why not mod N",
      "items": [
        "hash(key) % N remaps ~80% of keys going from 4 nodes to 5",
        "For a cache that's a near-total wipe at the worst moment"
      ]
    },
    {
      "dot": "emerald",
      "title": "In practice",
      "items": [
        "Nodes and keys share one 32- or 128-bit hash space",
        "Virtual nodes even out the load per physical node"
      ]
    }
  ],
