  "cards": [
    {
      "dot": "cyan",
      "title": "Two subsystems",
      "items": [
        "Tile serving is CDN-cacheable, near-static and read-dominated \u2014 ~1.7M req/s at peak estimates",
        "Routing is a specialised low-latency graph query; the halves barely share request-time infrastructure"
      ]
    },
    {
      "dot": "emerald",
      "title": "Contraction Hierarchies",
      "items": [
        "Offline contraction adds shortcuts past unimportant nodes, so queries run sub-millisecond",
        "Precomputation bakes in static edge costs \u2014 live traffic does not cleanly fit the model"
      ]
    },
    {
      "dot": "rose",
      "title": "Graceful degradation",
      "items": [
        "Traffic pipeline dies: fall back to last-known or time-of-day average weights \u2014 ETAs get worse, never broken",
        "Road closures ride a fast exception layer on top of the stale precomputed graph"
      ]
    }
  ],
