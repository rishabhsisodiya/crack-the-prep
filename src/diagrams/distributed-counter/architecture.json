  "cards": [
    {
      "dot": "cyan",
      "title": "Edge first, count second",
      "items": [
        "INSERT \u2026 ON CONFLICT DO NOTHING \u2014 a row inserted means +1",
        "Double-taps and retries are harmless by construction"
      ]
    },
    {
      "dot": "emerald",
      "title": "Write coalescing",
      "items": [
        "Don't write every increment to the database",
        "Aggregate deltas in memory, flush one increment per post per second"
      ]
    },
    {
      "dot": "orange",
      "title": "Sharded counters",
      "items": [
        "Split one logical counter into N sub-counters; a read sums all N",
        "Contention drops by N; make N dynamic for hot posts"
      ]
    }
