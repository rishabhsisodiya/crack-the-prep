{
  "cards": [
    {
      "dot": "rose",
      "items": [
        "One skewed customer key parks most executors idle while one task runs for an hour",
        "Thousands of tiny files make planning and task overhead \u2014 not bytes \u2014 the bottleneck",
        "One slow source gates the whole DAG when every downstream task waits for it"
      ],
      "title": "Where the window is lost"
    },
    {
      "dot": "cyan",
      "items": [
        "Incremental: watermark extraction, only changed rows \u2014 right for large, mostly-static history",
        "Full refresh: simpler and correct for small or restatement-heavy tables; expensive at 500 GB",
        "Rule: incremental by default, full refresh on a schedule or after a source restatement"
      ],
      "title": "Incremental vs full refresh"
    },
    {
      "dot": "emerald",
      "items": [
        "Salt skewed keys, repartition to ~128\u2013256 MB partitions, compact small files on landing",
        "Per-task retries, SLA alerts at T+60 and T+90, and a pre-computed fallback for reports"
      ],
      "title": "Fitting the window"
    }
  ],
