  "cards": [
    {
      "title": "Instant playback",
      "dot": "cyan",
      "items": [
        "Files are small (~3.5 MB a track) \u2014 fetch whole in a few range requests and prefetch the next queued track",
        "Local cache of recent and frequent tracks makes skipping feel instant"
      ]
    },
    {
      "title": "Play events are money",
      "dot": "emerald",
      "items": [
        "A stream counts after a minimum listen (commonly 30 seconds); events carry ids for dedup and are stored durably",
        "Batch jobs produce the authoritative royalty counts, with fraud detection before payouts"
      ]
    },
    {
      "title": "Offline & long tail",
      "dot": "rose",
      "items": [
        "Downloads are encrypted, tied to account and device, and need a periodic check-in (e.g. every 30 days)",
        "Popular tracks stay hot at the edge; long-tail misses fall through tiered caching to origin"
      ]
    }
  ],
