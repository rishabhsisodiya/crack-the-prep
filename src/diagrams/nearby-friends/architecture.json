  "cards": [
    {
      "dot": "cyan",
      "title": "Write-heavy, push-based",
      "items": [
        "Opposite profile to proximity search: every opted-in phone writes every few seconds, continuously",
        "Updates are pushed over persistent connections, not pulled by an on-demand query per friend"
      ]
    },
    {
      "dot": "emerald",
      "title": "Fan-out",
      "items": [
        "Fan out only to friends actively viewing the feature \u2014 O(active viewers), not O(all friends)",
        "Candidate set is mutual, opted-in, active friends: tens, so a Haversine loop beats a spatial index"
      ]
    },
    {
      "dot": "rose",
      "title": "Latest position only",
      "items": [
        "Overwrite one row per user with a short TTL \u2014 no growing location history to leak or purge",
        "Pipeline down: friends freeze at last known position; the durable queue catches up on recovery"
      ]
    }
  ],
