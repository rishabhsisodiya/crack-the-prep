  "cards": [
    {
      "title": "The core move",
      "dot": "cyan",
      "items": [
        "Split metadata from blob content: strongly consistent metadata DB at TB scale, content-addressed block store at exabyte scale",
        "Content addressing gives dedup for free \u2014 identical bytes share one stored block and a reference count"
      ]
    },
    {
      "title": "Delta sync",
      "dot": "emerald",
      "items": [
        "Client sends only chunk hashes; the server names the hashes it lacks and only those chunks upload",
        "A one-byte edit to a 2 GB file never re-uploads 2 GB"
      ]
    },
    {
      "title": "Conflicts",
      "dot": "rose",
      "items": [
        "Version mismatch on reconnect means a conflict: last-writer-wins for the canonical file",
        "The losing edit is preserved as a conflicted copy \u2014 a user's edit is never silently destroyed"
      ]
    }
  ],
