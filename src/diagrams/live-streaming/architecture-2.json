  "cards": [
    {
      "title": "Simulcast",
      "dot": "cyan",
      "items": [
        "Each sender uploads three qualities at once \u2014 high, mid and low",
        "The SFU picks per receiver from bandwidth and layout: active speaker high, thumbnails low"
      ]
    },
    {
      "title": "Why SFU, not MCU",
      "dot": "emerald",
      "items": [
        "SFU forwards packets without decoding \u2014 low server cost and flexible client layouts",
        "MCU decodes, mixes one composite and re-encodes \u2014 very high cost, kept for legacy devices"
      ]
    },
    {
      "title": "Scaling calls",
      "dot": "rose",
      "items": [
        "Cascade SFUs across regions and forward only visible tiles and the top active speakers",
        "If an SFU dies, clients rejoin via signaling to another SFU \u2014 room state lives outside it in Redis"
      ]
    }
