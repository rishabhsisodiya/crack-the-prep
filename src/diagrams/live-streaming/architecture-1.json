  "cards": [
    {
      "title": "Why broadcast scales",
      "dot": "cyan",
      "items": [
        "Every viewer requests the same segment URLs, so the CDN collapses millions of requests into a handful to origin",
        "HTTP delivery scales to millions in a way per-viewer WebRTC fan-out cannot"
      ]
    },
    {
      "title": "Latency budget",
      "dot": "emerald",
      "items": [
        "Encode buffer + segment duration x segments buffered (typically 3) + CDN \u2014 6s segments give ~20s latency",
        "LL-HLS parts (~200ms), chunked transfer and smaller buffers bring it down to a few seconds"
      ]
    },
    {
      "title": "Real-time constraint",
      "dot": "rose",
      "items": [
        "Transcoding must keep up with real time \u2014 a transcoder that falls behind adds latency forever",
        "Small channels may get source quality only, to save transcoding cost"
      ]
    }
  ],
