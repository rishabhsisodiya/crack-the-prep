    {
      "dot": "cyan",
      "title": "Buffering",
      "items": [
        "Agents ship to a Kafka buffer, so indexers consume at their own pace and log bursts never take the app down",
        "Processors parse, redact PII, enrich and sample before anything is stored"
      ]
    },
    {
      "dot": "emerald",
      "title": "Tiers",
      "items": [
        "Hot indexed storage for the last 7 days, then warm/cold tiers, with object storage as the long-term archive",
