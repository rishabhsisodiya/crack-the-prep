{
  "cards": [
    {
      "dot": "cyan",
      "items": [
        "The orchestrator fans one verified request out to every store that holds the user",
        "The registry tracks each store's task separately \u2014 a case is done only when every receipt is in"
      ],
      "title": "One case, many stores"
    },
    {
      "dot": "emerald",
      "items": [
        "OLTP rows deleted, Kafka tombstoned and compacted, lake files rewritten, index documents removed",
        "Per-user encryption keys destroyed (crypto-shredding) so backup copies become unreadable ciphertext"
      ],
      "title": "Erase, don't just hide"
    },
    {
      "dot": "rose",
      "items": [
        "Every store returns a signed receipt to an append-only audit ledger",
        "Verification scans re-check for the user_id after completion; the 30-day SLA clock is monitored per case"
      ],
      "title": "Provable, not promised"
    }
  ],
