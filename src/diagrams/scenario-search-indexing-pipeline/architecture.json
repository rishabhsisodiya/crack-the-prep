  "cards": [
    {
      "dot": "cyan",
      "items": [
        "CDC and feeds publish one change event per product change to Kafka",
        "Kafka partitioned by product_id keeps one product's changes in order"
      ],
      "title": "Ingestion"
    },
    {
      "dot": "emerald",
      "items": [
        "Workers enrich and bulk-index; version check drops duplicates and stale updates",
        "Bulk reindex builds a new index beside the live one, then swaps the alias atomically"
      ],
      "title": "Indexing"
    },
    {
      "dot": "rose",
      "items": [
        "At-least-once delivery plus version-guarded writes gives exactly-once effects in the index",
        "Freshness lag is measured end to end, from source change to searchable"
      ],
      "title": "Freshness"
    }
  ],
