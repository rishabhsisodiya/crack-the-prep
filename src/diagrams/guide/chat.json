  "cards": [
    {
      "dot": "cyan",
      "items": [
        "500M users hold long-lived WebSockets to a gateway; Redis registry maps userId to gateway node",
        "Gateway layer is stateless and disposable \u2014 the messages store is the source of truth"
      ],
      "title": "Connections"
    },
    {
      "dot": "emerald",
      "items": [
        "Client-generated message id makes send idempotent \u2014 retries never duplicate",
        "Persist first, then deliver, then recipient ACKs; unACKed messages re-send on reconnect"
      ],
      "title": "Delivery guarantees"
    },
    {
      "dot": "rose",
      "items": [
        "Socket heartbeats refresh a short-TTL Redis presence key; no heartbeat means offline, then push",
        "Gateway dies: client reconnects to any node and replays missed messages from last-seen id"
      ],
      "title": "Presence & failure"
    }
  ],
