  "cards": [
    {
      "dot": "cyan",
      "items": [
        "Resolve channel + preferences, check dedupe and per-user rate limits, then render and send",
        "Millions per hour, bursty \u2014 queue absorbs a marketing send across channels and providers"
      ],
      "title": "Worker pipeline"
    },
    {
      "dot": "emerald",
      "items": [
        "At-least-once queue + idempotent send on the dedupe key = effectively-once delivery",
        "Retries use exponential backoff; after N attempts the event goes to the DLQ with an alert"
      ],
      "title": "Reliability"
    },
    {
      "dot": "rose",
      "items": [
        "Circuit breaker on the primary provider's error rate flips traffic to a secondary, half-open probe recovers",
        "Provider webhooks update delivery status; hard bounces are suppressed for future sends"
      ],
      "title": "Failover & tracking"
    }
  ],
