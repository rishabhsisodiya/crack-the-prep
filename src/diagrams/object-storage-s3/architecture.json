  "cards": [
    {
      "dot": "cyan",
      "title": "Metadata / data split",
      "items": [
        "Metadata is small, fast and consistent \u2014 bucket/key to shard locations, size, version, ACLs",
        "Data plane is where bytes live and durability cost dominates; the two scale independently"
      ]
    },
    {
      "dot": "emerald",
      "title": "Erasure coding",
      "items": [
        "Any N of N+M shards reconstruct the object \u2014 ~1.2\u20131.5x overhead vs 3x replication",
        "Shards must sit in independent failure domains, or the durability math is false"
      ]
    },
    {
      "dot": "rose",
      "title": "Repair loop",
      "items": [
        "A dead storage node is the designed-for case: scrubber detects, reconstructs and re-writes the shard",
        "Without continuous repair, shard losses accumulate below the reconstruction threshold"
      ]
    }
  ],
