    {
      "dot": "cyan",
      "items": [
        "Scanners keep working offline against a local stock log and durable outbox",
        "Events carry event_id, SKU, delta, device clock and a per-warehouse sequence"
      ],
      "title": "Local first, sync later"
    },
    {
      "dot": "emerald",
      "items": [
        "Version vectors show whether two updates are causally ordered or truly concurrent",
        "Concurrent updates to the same SKU merge by delta where safe, and are flagged \u2014 never silently resolved by last-write-wins"
      ],
      "title": "Conflicts are detected, not overwritten"
    },
    {
      "dot": "rose",
      "items": [
        "Warehouses may count offline, but a sale reserves against the central stock DB with an atomic conditional decrement",
        "Cycle-count reconciliation closes the loop between system stock and physical stock"
      ],
      "title": "Selling is central, counting is distributed"
    }
  ],
