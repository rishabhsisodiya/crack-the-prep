  "cards": [
    {
      "dot": "cyan",
      "title": "The stampede problem",
      "items": [
        "A hot key expires and hundreds of requests hit the DB at once",
        "Single-flight: one recompute per key, everyone else waits"
      ]
    },
    {
      "dot": "emerald",
      "title": "Combined fixes",
      "items": [
        "TTL jitter so keys populated together don't expire together",
        "Early / probabilistic recompute refreshes before expiry",
        "Serve-stale-while-revalidate returns the old value instantly"
      ]
    },
    {
      "dot": "rose",
      "title": "If Redis dies",
      "items": [
        "Cap concurrency to the DB and degrade gracefully",
        "A small in-process cache absorbs the first wave"
      ]
    }
  ],
