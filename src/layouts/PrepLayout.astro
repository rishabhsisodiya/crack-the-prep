---
import BaseLayout from './BaseLayout.astro';
import TrackLinks from '../components/TrackLinks.astro';
import { SITE, trackBySlug, tracksIn, u } from '../consts';

type PagerLink = { href: string; label: string };
interface Props {
  track: string;
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** override the default track-to-track pager (used for chapter navigation) */
  prev?: PagerLink;
  next?: PagerLink;
  /** give the body the full page width: no side rails, track links in the collapsible panel */
  wide?: boolean;
}

const { track, title, description, ogType = 'article', prev: prevProp, next: nextProp, wide = false } = Astro.props;
const current = trackBySlug(track);

// default pager walks track-to-track, but never crosses from one roadmap into another
const siblings = current ? tracksIn(current.roadmap) : [];
const idx = siblings.findIndex((t) => t.slug === track);
const prev: PagerLink | null =
  prevProp ??
  (idx > 0 ? { href: u(`/${siblings[idx - 1].slug}`), label: siblings[idx - 1].title } : null);
const next: PagerLink | null =
  nextProp ??
  (idx >= 0 && idx < siblings.length - 1 ? { href: u(`/${siblings[idx + 1].slug}`), label: siblings[idx + 1].title } : null);

// The TOC slot is rendered twice: sticky sidebar on desktop, collapsible panel on mobile.
const tocHtml = Astro.slots.has('toc') ? await Astro.slots.render('toc') : '';

const pageUrl = new URL(Astro.url.pathname, SITE.url).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description,
    inLanguage: 'en',
    isAccessibleForFree: true,
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Prep', item: new URL(u('/'), SITE.url).href },
      { '@type': 'ListItem', position: 2, name: current?.title ?? title, item: new URL(u(`/${track}`), SITE.url).href },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];
---

<BaseLayout title={title} description={description} ogType={ogType} jsonLd={jsonLd}>
  <div class="read-progress" id="readProgress" aria-hidden="true"></div>
    <button class="rail-toggle" id="railToggle" type="button" aria-label="Show navigation sidebar" aria-expanded="false" hidden>
    <svg class="rail-toggle__open" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <rect x="3" y="4" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="2" />
      <path d="M9.5 4v16" stroke="currentColor" stroke-width="2" />
      <path d="M13 9l3 3-3 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <svg class="rail-toggle__close" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <rect x="3" y="4" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="2" />
      <path d="M9.5 4v16" stroke="currentColor" stroke-width="2" />
      <path d="M16 9l-3 3 3 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <div class:list={['prep', 'rail-hidden', { 'prep--wide': wide }]}>
    <aside class="prep-rail" aria-label="Tracks">
      <TrackLinks track={track} />
    </aside>

    <article class="prep-body">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={u('/')}>Prep</a>
        <span aria-hidden="true">/</span>
        <span>{current?.title ?? title}</span>
      </nav>

      <div class="mobile-nav">
        {tocHtml && (
          <details class="m-panel">
            <summary>On this page</summary>
            <div class="m-panel__body" set:html={tocHtml} />
          </details>
        )}
        <details class="m-panel">
          <summary>Tracks</summary>
          <div class="m-panel__body"><TrackLinks track={track} /></div>
        </details>
      </div>
      <slot />

      <nav class="pager" aria-label="Pagination">
        {prev ? (
          <a class="pager-link" rel="prev" href={prev.href}>
            <span class="pager-dir">← Previous</span>
            <span class="pager-title">{prev.label}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="pager-link pager-link--next" rel="next" href={next.href}>
            <span class="pager-dir">Next →</span>
            <span class="pager-title">{next.label}</span>
          </a>
        ) : <span />}
      </nav>
    </article>

    <div class="prep-toc" set:html={tocHtml} />
  </div>

  <button class="to-top" id="toTop" type="button" aria-label="Scroll to top" hidden>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</BaseLayout>

<script>
  const bar = document.getElementById('readProgress');
  const article = document.querySelector<HTMLElement>('.prep-body');
  if (bar && article) {
    const update = () => {
      const start = article.offsetTop;
      const end = start + article.offsetHeight - window.innerHeight;
      const pct = Math.min(1, Math.max(0, (window.scrollY - start) / Math.max(1, end - start)));
      bar.style.transform = `scaleX(${pct})`;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }

  // Scroll-to-top button: appears once the reader is past the first screen.
  const toTop = document.getElementById('toTop');
  if (toTop) {
    const toggle = () => { toTop.hidden = window.scrollY < window.innerHeight; };
    toggle();
    window.addEventListener('scroll', toggle, { passive: true });
    toTop.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }


  // Left rail (track navigation): hidden by default; the toggle button shows
  // or hides it, and the choice is remembered across pages.
  const prep = document.querySelector<HTMLElement>('.prep');
  const railToggle = document.getElementById('railToggle') as HTMLButtonElement | null;
  if (prep && railToggle && !prep.classList.contains('prep--wide')) {
    const applyRail = (open: boolean) => {
      prep.classList.toggle('rail-hidden', !open);
      railToggle.setAttribute('aria-expanded', String(open));
      railToggle.setAttribute('aria-label', open ? 'Hide navigation sidebar' : 'Show navigation sidebar');
    };
    let open = false;
    try { open = window.localStorage.getItem('ctp-rail') === 'open'; } catch { /* storage unavailable: stay hidden */ }
    applyRail(open);
    railToggle.hidden = false;
    railToggle.addEventListener('click', () => {
      open = prep.classList.contains('rail-hidden');
      applyRail(open);
      try { window.localStorage.setItem('ctp-rail', open ? 'open' : 'hidden'); } catch { /* ignore */ }
    });
  }

  // Close the mobile panels after jumping to a link.
  document.querySelectorAll<HTMLDetailsElement>('.m-panel').forEach((panel) => {
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) panel.open = false;
    });
  });
</script>

<style>
  .prep {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 2.5rem clamp(1.1rem, 4vw, 3rem) 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 960px) {
    .prep { grid-template-columns: 200px minmax(0, 1fr) 200px; }
  }

  @media (min-width: 960px) {
    .prep--wide { grid-template-columns: minmax(0, 1fr); }
    .prep--wide .prep-rail, .prep--wide .prep-toc { display: none; }
    .prep--wide .mobile-nav { display: flex; }
  }

  .prep-rail { display: none; }
  @media (min-width: 960px) {
    .prep-rail { display: block; position: sticky; top: 5rem; align-self: start; }
  }
  .prep-toc :global(.toc-label) {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.8rem;
  }
  .prep-body { min-width: 0; }

  /* mobile: section + track navigation (sidebars are hidden below 960px) */
  .mobile-nav { display: flex; flex-direction: column; gap: 0.6rem; margin: -0.4rem 0 1.6rem; }
  @media (min-width: 960px) { .mobile-nav { display: none; } }
  .m-panel {
    border: 1px solid var(--navy-line);
    border-radius: 6px;
    background: var(--navy-card);
  }
  .m-panel > summary {
    cursor: pointer;
    list-style: none;
    padding: 0.65rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
    display: flex;
    justify-content: space-between;
  }
  .m-panel > summary::-webkit-details-marker { display: none; }
  .m-panel > summary::after { content: '▾'; color: var(--muted); transition: transform 0.2s; }
  .m-panel[open] > summary::after { transform: rotate(180deg); }
  .m-panel__body {
    border-top: 1px solid var(--navy-line);
    padding: 0.7rem 0.9rem 0.9rem;
    max-height: 60vh;
    overflow-y: auto;
  }
  .m-panel__body :global(.toc-label) { display: none; }
  .m-panel__body :global(.toc) { max-height: none; }

  .crumbs {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.4rem;
  }

  .prep-toc { display: none; }
  @media (min-width: 960px) {
    .prep-toc { display: block; position: sticky; top: 5rem; align-self: start; }
  }

  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--electric), var(--cyan));
    transform: scaleX(0);
    transform-origin: 0 50%;
    z-index: 120;
  }

  .to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--navy-line-2);
    border-radius: 50%;
    background: var(--navy-card);
    color: var(--cyan);
    cursor: pointer;
    z-index: 110;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);
    transition: transform 0.15s, border-color 0.15s;
  }
  .to-top:hover { border-color: var(--cyan); transform: translateY(-2px); }
  .to-top:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }


  /* Left rail collapsed: body + TOC take the full width */
  @media (min-width: 960px) {
    .prep.rail-hidden:not(.prep--wide) { grid-template-columns: minmax(0, 1fr) 200px; }
    .prep.rail-hidden .prep-rail { display: none; }
  }

  .rail-toggle {
    display: none;
  }
  @media (min-width: 960px) {
    .rail-toggle {
      position: fixed;
      left: clamp(0.9rem, 2vw, 1.6rem);
      top: 5.2rem;
      width: 2.6rem;
      height: 2.6rem;
      display: grid;
      place-items: center;
      border: 1px solid var(--navy-line-2);
      border-radius: 50%;
      background: var(--navy-card);
      color: var(--cyan);
      cursor: pointer;
      z-index: 110;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);
      transition: transform 0.15s, border-color 0.15s;
    }
    .rail-toggle:hover { border-color: var(--cyan); transform: translateY(-2px); }
    .rail-toggle:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }
    .rail-toggle[hidden] { display: none; }
    .rail-toggle .rail-toggle__close { display: none; }
    .rail-toggle[aria-expanded="true"] .rail-toggle__close { display: block; }
    .rail-toggle[aria-expanded="true"] .rail-toggle__open { display: none; }
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--navy-line);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--navy-line);
    border-radius: 6px;
    max-width: 48%;
  }
  .pager-link:hover { border-color: var(--navy-line-2); }
  .pager-link--next { text-align: right; align-items: flex-end; }
  .pager-dir { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .pager-title { color: var(--white); font-weight: 600; }
  @media (max-width: 520px) {
  
  /* Left rail collapsed: body + TOC take the full width */
  @media (min-width: 960px) {
    .prep.rail-hidden:not(.prep--wide) { grid-template-columns: minmax(0, 1fr) 200px; }
    .prep.rail-hidden .prep-rail { display: none; }
  }

  .rail-toggle {
    display: none;
  }
  @media (min-width: 960px) {
    .rail-toggle {
      position: fixed;
      left: clamp(0.9rem, 2vw, 1.6rem);
      top: 5.2rem;
      width: 2.6rem;
      height: 2.6rem;
      display: grid;
      place-items: center;
      border: 1px solid var(--navy-line-2);
      border-radius: 50%;
      background: var(--navy-card);
      color: var(--cyan);
      cursor: pointer;
      z-index: 110;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);
      transition: transform 0.15s, border-color 0.15s;
    }
    .rail-toggle:hover { border-color: var(--cyan); transform: translateY(-2px); }
    .rail-toggle:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }
    .rail-toggle[hidden] { display: none; }
    .rail-toggle .rail-toggle__close { display: none; }
    .rail-toggle[aria-expanded="true"] .rail-toggle__close { display: block; }
    .rail-toggle[aria-expanded="true"] .rail-toggle__open { display: none; }
  }

  .pager { flex-direction: column; }
    .pager-link { max-width: 100%; }
  }
</style>
