---
import type { Track } from '../consts';
import { u } from '../consts';

interface Props { track: Track }
const { track } = Astro.props;
---

<a class="card" href={u(`/${track.slug}`)}>
  <span class="card-badge" aria-hidden="true">{track.badge}</span>
  <span class="card-body">
    <span class="card-title">{track.title}</span>
    <span class="card-blurb">{track.blurb}</span>
    {track.hasQuestions && <span class="card-meta">notes + questions</span>}
  </span>
  <span class="card-arrow" aria-hidden="true">→</span>
</a>

<style>
  .card {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    padding: 1.5rem 1.6rem;
    background: var(--navy-card);
    border: 1px solid var(--navy-line);
    border-radius: var(--radius);
    transition: border-color .25s, transform .25s, box-shadow .25s;
  }
  .card:hover {
    border-color: var(--navy-line-2);
    transform: translateY(-3px);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.3);
  }
  .card-badge {
    flex-shrink: 0;
    width: 42px; height: 42px;
    display: grid; place-items: center;
    border: 1px solid var(--navy-line-2);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--cyan);
  }
  .card-body { display: flex; flex-direction: column; gap: 0.3rem; }
  .card-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: 0.05em;
    color: var(--white);
  }
  .card-blurb { font-size: 0.9rem; color: var(--text); }
  .card-meta {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card-arrow { margin-left: auto; color: var(--muted); transition: transform .25s, color .25s; }
  .card:hover .card-arrow { color: var(--cyan); transform: translateX(3px); }
</style>
