---
import { ROADMAPS, trackBySlug, tracksIn, u } from '../consts';

interface Props { track: string }
const { track } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');

// each roadmap gets its own sidebar. The AI roadmap stays focused on itself;
// full-stack pages get a link across to it.
const roadmapId = trackBySlug(track)?.roadmap ?? 'fullstack';
const current = ROADMAPS.filter((r) => r.id === roadmapId);
const others = roadmapId === 'ai' ? [] : ROADMAPS.filter((r) => r.id !== roadmapId);
---

{current.map((r) => (
<div class="roadmap">
<p class="roadmap-label">{r.title}</p>
<ul class="track-links">
  {tracksIn(r.id).map((t) => {
    const onTrack = t.slug === track;
    const onQuestions = onTrack && path.endsWith('/questions');
    const activeSection = onTrack
      ? t.sections?.find((sec) => path === u(`/${t.slug}/${sec.path}`).replace(/\/$/, '') || path.startsWith(u(`/${t.slug}/${sec.path}/`)))
      : undefined;
    return (
      <li>
        <a href={u(`/${t.slug}`)} aria-current={onTrack && !onQuestions && !activeSection ? 'page' : undefined}>
          {t.title}
        </a>
        {t.hasQuestions && (
          <a class="sub" href={u(`/${t.slug}/questions`)} aria-current={onQuestions ? 'page' : undefined}>
            Interview questions
          </a>
        )}
        {t.sections?.map((sec) => (
          <a class="sub" href={u(`/${t.slug}/${sec.path}`)} aria-current={activeSection === sec ? 'page' : undefined}>
            {sec.label}
          </a>
        ))}
      </li>
    );
  })}
</ul>
</div>
))}
{others.map((r) => (
  <a class="roadmap-switch" href={u(`/${tracksIn(r.id)[0].slug}`)}>{r.title} →</a>
))}

<style>
  .roadmap-switch {
    display: block;
    margin-top: 1.4rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--navy-line);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .roadmap-switch:hover { color: var(--cyan); }
  .roadmap-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyan);
    margin: 0 0 0.5rem;
  }
  .track-links { list-style: none; display: flex; flex-direction: column; gap: 0.15rem; }
  .track-links a {
    display: block;
    padding: 0.3rem 0 0.3rem 0.9rem;
    border-left: 2px solid var(--navy-line);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .track-links a:hover { color: var(--white); }
  .track-links a[aria-current='page'] { color: var(--cyan); border-left-color: var(--cyan); }
  .track-links a.sub { padding-left: 1.7rem; font-size: 0.78rem; }
</style>
