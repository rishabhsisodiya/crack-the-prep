---
import { SITE, TRACKS, u } from '../consts';
const { pathname } = Astro.url;
const isActive = (slug: string) => pathname.replace(/\/$/, '').endsWith(`/${slug}`);
---

<nav class="nav" id="nav">
  <a class="brand" href={u('/')} aria-label={`${SITE.name} home`}>
    <span class="brand-mark" aria-hidden="true"></span>
    <span class="brand-text">
      <span class="brand-name">CRACKTHE</span>
      <span class="brand-sub">PREP</span>
    </span>
  </a>

  <button class="menu-toggle" id="menuToggle" aria-expanded="false" aria-controls="navLinks">
    <span aria-hidden="true">☰</span><span class="sr-only">Menu</span>
  </button>

  <ul class="nav-links" id="navLinks">
    {TRACKS.map((t) => (
      <li>
        <a href={u(`/${t.slug}`)} aria-current={isActive(t.slug) ? 'page' : undefined}>
          {t.title}
        </a>
      </li>
    ))}
    <li><a href={u('/search')} aria-current={pathname.endsWith('/search') ? 'page' : undefined}>Search</a></li>
  </ul>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.85rem clamp(1.1rem, 4vw, 3rem);
    background: rgba(10, 22, 40, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--navy-line);
  }

  .brand { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .brand-mark {
    width: 26px; height: 26px; border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, var(--accent), var(--electric) 70%);
    box-shadow: 0 0 14px rgba(0, 180, 216, 0.45);
  }
  .brand-text { display: flex; flex-direction: column; line-height: 1; gap: 3px; }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: 0.14em;
    color: var(--white);
  }
  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.34em;
    color: var(--muted);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    list-style: none;
    margin-left: auto;
    flex-wrap: wrap;
  }
  .nav-links a {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .nav-links a:hover,
  .nav-links a[aria-current='page'] { color: var(--cyan); }
  .nav-links__out a { color: rgba(240, 244, 255, 0.4); }

  .menu-toggle {
    display: none;
    margin-left: auto;
    background: none;
    border: none;
    color: var(--cyan);
    font-size: 1.3rem;
    cursor: pointer;
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  @media (max-width: 860px) {
    .menu-toggle { display: block; }
    .nav-links {
      display: none;
      position: absolute;
      top: 100%; left: 0; right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background: rgba(10, 22, 40, 0.98);
      border-bottom: 1px solid var(--navy-line);
      padding: 0.5rem clamp(1.1rem, 4vw, 3rem) 1rem;
    }
    .nav-links.open { display: flex; }
    .nav-links li { width: 100%; padding: 0.65rem 0; border-bottom: 1px solid var(--navy-line); }
    .nav-links li:last-child { border-bottom: none; }
  }
</style>

<script>
  const btn = document.getElementById('menuToggle');
  const links = document.getElementById('navLinks');
  btn?.addEventListener('click', () => {
    const open = links?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
</script>
